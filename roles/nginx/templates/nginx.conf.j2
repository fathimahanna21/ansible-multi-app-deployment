server {
    listen 80;
    server_name _;

    location /flask/ {
        proxy_pass http://127.0.0.1:{{ flask_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /node/ {
        proxy_pass http://127.0.0.1:{{ node_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
